# App chỉ có URL và anon key. KHÔNG đặt service_role, khóa cổng thanh toán, token Zalo ở đây.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Số hotline hiện trên app (nút "Gọi hỗ trợ")
EXPO_PUBLIC_SUPPORT_PHONE=1900xxxx
# Trang chính sách dữ liệu đầy đủ
EXPO_PUBLIC_POLICY_URL=https://example.com/chinh-sach
# Expo project id (EAS) — cần để lấy mã thông báo đẩy
EXPO_PUBLIC_EAS_PROJECT_ID=

# --- Secrets của Edge Functions (đặt bằng: supabase secrets set ...), không phải biến của app ---
# SEPAY_WEBHOOK_SECRET=   (HMAC, ưu tiên)  hoặc  SEPAY_API_KEY=
# PUSH_WEBHOOK_SECRET=
# CRON_SECRET=
# EXPO_ACCESS_TOKEN=      (tùy chọn)
