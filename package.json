{
  "name": "quickpos",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "typecheck:logic": "tsc -p tsconfig.logic.json",
    "test": "tsx --test tests/*.test.ts",
    "test:db": "psql \"$SUPABASE_DB_URL\" -v ON_ERROR_STOP=1 -f supabase/tests/rls_and_numbering.sql -f supabase/tests/app_v1_gaps.sql -f supabase/tests/debts_expenses_tax.sql",
    "gen:types": "supabase gen types typescript --local > src/types/database.ts"
  },
  "dependencies": {
    "expo": "~57.0.0"
  },
  "devDependencies": {}
}
