{
  "//": "Kiểm tra kiểu phần logic thuần và Edge Functions dùng chung — chạy được không cần cài Expo.",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": []
  },
  "files": [
    "src/lib/money.ts",
    "src/lib/time.ts",
    "src/lib/errors.ts",
    "src/lib/retry.ts",
    "src/theme/layout.ts",
    "src/features/sale/paymentState.ts",
    "src/features/offline/queue.ts",
    "src/features/journal/summary.ts",
    "src/features/settings/pinLogic.ts",
    "supabase/functions/_shared/vietqr.ts",
    "supabase/functions/_shared/banks.ts",
    "supabase/functions/_shared/sepay.ts",
    "supabase/functions/_shared/push.ts",
    "supabase/functions/_shared/vnmoney.ts"
  ]
}
